# ==== GenshinFlow — mẫu biến môi trường ====
# Sao chép file này thành `.env` và điền giá trị THẬT. KHÔNG commit `.env`.

# =============================================================================
# DATABASE (Supabase Postgres)
# =============================================================================
# Lấy từ Supabase Dashboard → Project Settings → Database → Connection string.
# - DATABASE_URL dùng "Transaction pooler" (port 6543) cho serverless / edge.
# - DIRECT_URL  dùng "Direct connection" (port 5432) cho Prisma Migrate / seed.
# Thay [YOUR-PASSWORD] bằng database password đã đặt cho project Supabase.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# =============================================================================
# AUTH — BẮT BUỘC
# =============================================================================
# NEXTAUTH_SECRET: chuỗi ngẫu nhiên >= 32 ký tự, dùng ký JWT session.
# Sinh nhanh:    node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET="CHANGE_ME_random_secret_at_least_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# PAYOS (thanh toán VN)
# =============================================================================
# Lấy từ https://my.payos.vn → Kênh thanh toán → API credentials.
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"
# Webhook URL PayOS gọi về (PHẢI là HTTPS public khi deploy production).
#   - Dev:     PAYOS_WEBHOOK_URL="http://localhost:3000/api/webhooks/payos"
#   - Prod:    PAYOS_WEBHOOK_URL="https://YOUR-DOMAIN.COM/api/webhooks/payos"
# Sau khi đổi, truy cập https://my.payos.vn → Kênh thanh toán → Webhook URL để update.
PAYOS_WEBHOOK_URL="http://localhost:3000/api/webhooks/payos"

# =============================================================================
# MÃ HOÁ — BẮT BUỘC
# =============================================================================
# AES-256-GCM key cho mật khẩu game (OrderCredential). Đúng 32 ký tự.
# Sinh nhanh:   node -e "console.log(require('crypto').randomBytes(32).toString('base64').slice(0,32))"
ENCRYPTION_KEY="CHANGE_ME_encryption_key_32_chars_min"

# =============================================================================
# STORAGE — Supabase Storage (Sprint 1+)
# =============================================================================
# Public + service-role keys lấy từ Supabase Dashboard → Project Settings → API.
# CHÚ Ý: service_role key là quyền admin — không bao giờ để lộ ở client.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Bucket mặc định cho upload (screenshot kết quả, avatar, asset review, …).
SUPABASE_STORAGE_BUCKET="genshinflow-assets"

# =============================================================================
# EMAIL — Resend (Sprint 5)
# =============================================================================
# Đăng ký tại https://resend.com → API Keys. Bỏ trống = tắt email (chỉ in-app).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@genshinflow.vn"
RESEND_FROM_NAME="GenshinFlow"

# =============================================================================
# ANALYTICS — PostHog (Sprint 6)
# =============================================================================
# Self-host bằng https://posthog.com hoặc dùng cloud. Bỏ trống = tắt tracking.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# =============================================================================
# RATE LIMIT — Upstash Redis (Sprint 1+)
# =============================================================================
# Bỏ trống = dùng in-memory rate limit (chỉ phù hợp dev, không scale).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =============================================================================
# SENTRY — error monitoring (Sprint 1+)
# =============================================================================
# Bỏ trống = tắt Sentry. Tạo project tại https://sentry.io → Project Settings.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# =============================================================================
# APP — các cấu hình chung
# =============================================================================
NODE_ENV="development"
# URL public của app (production). Dùng cho OG image, sitemap, PayOS return URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Giới hạn upload mặc định (MB).
NEXT_PUBLIC_MAX_UPLOAD_MB="10"

# =============================================================================
# OPTIONAL — tích hợp thêm
# =============================================================================
# Google OAuth (Sprint 6): tạo tại https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Zalo OA (Sprint 5): dùng cho notification qua Zalo.
ZALO_OA_ACCESS_TOKEN=""
